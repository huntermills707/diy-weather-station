# Local station alerts (JAE-65): offline station, freeze risk, missing backup.
# A separate service from the ingest API, so it notices when that one is down.
# Install steps: deploy/README.md. Thresholds: docs/alerts.md.
[Unit]
Description=Weather station alerts
Documentation=https://github.com/huntermills707/diy-weather-station/blob/main/docs/alerts.md
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=weather-station
Group=weather-station
WorkingDirectory=/opt/weather-station/server
# WEATHER_STATION_NTFY_URL lives in the same file as the ingest token.
EnvironmentFile=/etc/weather-station/env
Environment=WEATHER_STATION_DB_PATH=/var/lib/weather-station/weather.db
Environment=WEATHER_STATION_BACKUP_DIR=/var/backups/weather-station
ExecStart=/opt/weather-station/server/.venv/bin/python -m weather_station_server.alerts
Restart=always
RestartSec=30

# Alert state is kept in /var/lib/weather-station/alerts.json.
StateDirectory=weather-station
UMask=0027

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
