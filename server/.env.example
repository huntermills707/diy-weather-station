# Local server configuration template (issue #23). Copy to .env (gitignored)
# and load it into the environment before starting the service, e.g.:
#   set -a; . ./.env; set +a
# On the Pi, systemd reads these from a root-readable EnvironmentFile
# instead (ADR 0001) — .env is for local development only.

# Per-station pre-shared token for reading submissions (Authorization: Bearer).
# Must match INGEST_TOKEN in the station's firmware/secrets.h.
WEATHER_STATION_INGEST_TOKEN=generate-a-long-random-token
