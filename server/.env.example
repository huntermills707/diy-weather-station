# Local server configuration template (issue #23). Copy to .env (gitignored)
# and load it into the environment before starting the service, e.g.:
#   set -a; . ./.env; set +a
# On the Pi, systemd reads these from a root-readable EnvironmentFile
# instead (ADR 0001) — .env is for local development only.

# Per-station pre-shared token for reading submissions (Authorization: Bearer).
# Must match INGEST_TOKEN in the station's firmware/secrets.h.
WEATHER_STATION_INGEST_TOKEN=generate-a-long-random-token

# SQLite file for readings (docs/database.md). Optional; defaults to
# weather.db in the working directory. systemd sets it on the Pi.
# WEATHER_STATION_DB_PATH=weather.db

# Station altitude in metres, for sea-level pressure (docs/read-api.md).
# Optional; unset means sea-level pressure is unavailable.
# WEATHER_STATION_ALTITUDE_M=50

# Time zone for daily and monthly rain totals. Optional; defaults to the
# host's time zone, else UTC.
# WEATHER_STATION_TIMEZONE=America/Los_Angeles
